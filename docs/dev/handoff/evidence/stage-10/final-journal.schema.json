{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ketos.test/evidence/stage-10/final-journal.schema.json",
  "title": "Ketos Stage 10 Final Journal",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "s10_code_sha",
    "owner",
    "retention_policy",
    "started_at",
    "ended_at",
    "command",
    "cwd",
    "exit_code",
    "verdict",
    "sections"
  ],
  "properties": {
    "schema": {"const": "ketos.stage10.final-journal.v1"},
    "s10_code_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "owner": {"type": "string", "minLength": 1},
    "retention_policy": {"type": "string", "minLength": 1},
    "started_at": {"type": "string", "format": "date-time"},
    "ended_at": {"type": "string", "format": "date-time"},
    "command": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "cwd": {"type": "string", "minLength": 1},
    "exit_code": {"const": 0},
    "verdict": {"const": "PASS"},
    "sections": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "allOf": [
        {"contains": {"properties": {"id": {"const": "completed_tasks"}}, "required": ["id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"id": {"const": "partial_tasks"}}, "required": ["id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"id": {"const": "defects"}}, "required": ["id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"id": {"const": "blockers"}}, "required": ["id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"id": {"const": "tests"}}, "required": ["id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"id": {"const": "subagents"}}, "required": ["id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"id": {"const": "acceptance"}}, "required": ["id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"id": {"const": "closure"}}, "required": ["id"]}, "minContains": 1, "maxContains": 1}
      ],
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "owner", "verdict", "evidence"],
        "properties": {
          "id": {
            "enum": [
              "completed_tasks",
              "partial_tasks",
              "defects",
              "blockers",
              "tests",
              "subagents",
              "acceptance",
              "closure"
            ]
          },
          "owner": {"type": "string", "minLength": 1},
          "verdict": {"const": "PASS"},
          "evidence": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
