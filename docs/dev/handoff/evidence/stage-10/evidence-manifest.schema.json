{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ketos.test/evidence/stage-10/evidence-manifest.schema.json",
  "title": "Ketos Stage 10 Evidence Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "stage",
    "s10_code_sha",
    "base_sha",
    "owner",
    "retention_owner",
    "retention_policy",
    "retention_class",
    "generated_at",
    "persistent_root",
    "filesystem",
    "volume_uuid",
    "canonical_bundle",
    "no_secret_qa",
    "seal_control",
    "verdict",
    "artifacts"
  ],
  "properties": {
    "schema": {"const": "ketos.stage10.evidence-manifest.v1"},
    "stage": {"const": 10},
    "s10_code_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "base_sha": {"const": "18a2a2a9518d23c589c6700c322ad5844adce932"},
    "owner": {"type": "string", "minLength": 1},
    "retention_owner": {"type": "string", "minLength": 1},
    "retention_policy": {"type": "string", "minLength": 1},
    "retention_class": {"const": "indefinite"},
    "generated_at": {"type": "string", "format": "date-time"},
    "persistent_root": {"type": "string", "pattern": "^/"},
    "filesystem": {"type": "string", "minLength": 1},
    "volume_uuid": {"type": "string", "minLength": 1},
    "canonical_bundle": {"type": "string", "pattern": "^/"},
    "no_secret_qa": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "verdict", "matches"],
      "properties": {
        "path": {"const": "no-secret-qa.json"},
        "verdict": {"const": "PASS"},
        "matches": {"const": 0}
      }
    },
    "seal_control": {"const": "apfs-uchg"},
    "verdict": {"const": "PASS"},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "size_bytes",
          "owner",
          "redacted_path",
          "producing_command",
          "started_at",
          "ended_at",
          "verdict",
          "schema_version"
        ],
        "properties": {
          "path": {"type": "string", "minLength": 1, "not": {"pattern": "^/"}},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "size_bytes": {"type": "integer", "minimum": 1},
          "owner": {"type": "string", "minLength": 1},
          "redacted_path": {"type": "string", "pattern": "^\\$KETOS_STAGE10_EVIDENCE_BUNDLE/"},
          "producing_command": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "started_at": {"type": "string", "format": "date-time"},
          "ended_at": {"type": "string", "format": "date-time"},
          "verdict": {"const": "PASS"},
          "schema_version": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
