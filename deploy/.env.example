DOMAIN=localhost
STACK_NAME=ketos-stack

TRAEFIK_PUBLIC_NETWORK=traefik-public
TRAEFIK_TAG=ketos-traefik
TRAEFIK_PUBLIC_TAG=traefik-public


# Ketos backend configuration
KETOS_CONFIG_DIR=/var/lib/ketos/config
KETOS_DATA_DIR=/var/lib/ketos/data
KETOS_CACHE_DIR=/var/cache/ketos
KETOS_TEMP_DIR=/tmp/ketos
KETOS_LOG_LEVEL=debug
KETOS_SUPERUSER=superuser
# Required: export a strong value before Docker Compose reads this file.
KETOS_SUPERUSER_PASSWORD=${KETOS_SUPERUSER_PASSWORD?Set a strong Ketos superuser password}
KETOS_NEW_USER_IS_ACTIVE=False


# Ketos frontend configuration
BACKEND_URL=http://backend:7860

# RabbitMQ configuration
RABBITMQ_DEFAULT_USER=ketos
RABBITMQ_DEFAULT_PASS=${RABBITMQ_DEFAULT_PASS?Set a strong RabbitMQ password}

# Database configuration
DB_USER=ketos
DB_PASSWORD=${POSTGRES_PASSWORD?Set a strong PostgreSQL password}
DB_HOST=db
DB_PORT=5432
DB_NAME=ketos

# DB configuration
POSTGRES_USER=ketos
POSTGRES_PASSWORD=${POSTGRES_PASSWORD?Set a strong PostgreSQL password}
POSTGRES_DB=ketos
POSTGRES_PORT=5432

# Flower configuration
# Redis-backed cache is optional; configure authentication before enabling it.
#KETOS_CACHE_TYPE=redis
KETOS_REDIS_HOST=result_backend
KETOS_REDIS_PORT=6379
KETOS_REDIS_DB=0
KETOS_REDIS_EXPIRE=3600
KETOS_REDIS_PASSWORD=
FLOWER_UNAUTHENTICATED_API=False
BROKER_URL=amqp://${RABBITMQ_DEFAULT_USER}:${RABBITMQ_DEFAULT_PASS}@broker:5672
RESULT_BACKEND=redis://result_backend:6379/0
C_FORCE_ROOT="true"


# PGAdmin configuration
PGADMIN_DEFAULT_EMAIL=admin@admin.com
PGADMIN_DEFAULT_PASSWORD=${PGADMIN_DEFAULT_PASSWORD?Set a strong pgAdmin password}
