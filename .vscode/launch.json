{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Ketos backend",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "preLaunchTask": "Install Backend",
      "args": [
        "--factory",
        "ketos.main:create_app",
        "--port",
        "7860",
        "--reload",
        "--log-level",
        "debug",
        "--loop",
        "asyncio",
        "--reload-include",
        "./src/backend/*",
        "--reload-include",
        "./src/kfx/*",
        "--reload-exclude",
        "*.db*"
      ],
      "justMyCode": false,
      "env": {
        "KETOS_LOG_LEVEL": "debug",
        "KETOS_PROMETHEUS_PORT": "9090"
      },
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": "Debug Ketos CLI",
      "type": "debugpy",
      "request": "launch",
      "module": "ketos",
      "args": ["run", "--env-file", "${workspaceFolder}/.env"],
      "justMyCode": false
    },
    {
      "name": "Debug frontend",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:3000/",
      "webRoot": "${workspaceFolder}/src/frontend"
    },
    {
      "name": "Debug current Python test",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "purpose": ["debug-test"],
      "console": "integratedTerminal",
      "justMyCode": false
    }
  ]
}
