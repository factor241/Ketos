{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ketos.test/evidence/stage-08/transition-input.schema.json",
  "title": "Ketos Stage 08 coordinator transition input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "stage",
    "baseSha",
    "syncASha",
    "frozenSha",
    "stagePassReferences",
    "officialDocumentation",
    "taskHandoffs",
    "reviews",
    "deviations",
    "closedDefects"
  ],
  "properties": {
    "schemaVersion": {"const": "1"},
    "stage": {"const": "08"},
    "baseSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "syncASha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "frozenSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "stagePassReferences": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stage", "status", "evidence"],
        "properties": {
          "stage": {"enum": ["01", "05", "06", "07"]},
          "status": {"const": "PASS"},
          "evidence": {"type": "string", "minLength": 1}
        }
      }
    },
    "officialDocumentation": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "url"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "url": {"type": "string", "format": "uri", "pattern": "^https://"}
        }
      }
    },
    "taskHandoffs": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "taskId",
          "owner",
          "baseSha",
          "commitSha",
          "changedPaths",
          "reviewerId",
          "reviewVerdict"
        ],
        "properties": {
          "taskId": {"enum": ["S08-A01", "S08-A02", "S08-A03", "S08-A04", "S08-A05", "S08-A06", "S08-A07", "S08-A08", "S08-A09", "S08-A10"]},
          "owner": {"type": "string", "minLength": 1},
          "baseSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "commitSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "changedPaths": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "reviewerId": {"type": "string", "minLength": 1},
          "reviewVerdict": {"const": "PASS"}
        }
      }
    },
    "reviews": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reviewerId", "kind", "scope", "inputSha", "verdict", "findings", "resolution"],
        "properties": {
          "reviewerId": {"type": "string", "minLength": 1},
          "kind": {"enum": ["practical", "independent"]},
          "scope": {"type": "string", "minLength": 1},
          "inputSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "verdict": {"const": "PASS"},
          "findings": {"type": "string", "minLength": 1},
          "resolution": {"type": "string", "minLength": 1}
        }
      }
    },
    "deviations": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "closedDefects": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    }
  }
}
