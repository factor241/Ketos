# Copy to `.env` on each computer of the stand and fill in this computer's
# values. The file stays local: it carries the Syncthing GUI key and the model
# credential, so it is never committed.
#
# Computer 1 runs `docker compose -f docker/stand/compose.yaml up -d ketos-a`
# and names itself below; computer 2 runs `... up -d ketos-b` with its own
# name. KETOS_RELAY_URLS, KETOS_SYNCTHING_RELAY, and STGUIAPIKEY come from
# docker/relay (see docker/relay/README.md); STGUIAPIKEY is minted per computer
# with `openssl rand -hex 16`.

KETOS_PARTICIPANT_NAME=Участник-1
KETOS_RELAY_URLS=https://203-0-113-7.sslip.io
KETOS_SYNCTHING_RELAY=relay://203.0.113.7:22067/?id=<RELAY-ID>&token=<STRELAY-TOKEN>
STGUIAPIKEY=replace_with_openssl_rand_hex_16

# Model credential for the agent sessions (never baked into the image).
OPENCODE_GO_API_KEY=
