# Copy to `.env` on each computer of the stand and fill in this computer's
# values. The file stays local: it carries the Syncthing GUI key and the model
# credential, so it is never committed.
#
# Computer 1 runs `docker compose -f docker/stand/compose.yaml up -d ketos-a`
# and names itself below; computer 2 runs `... up -d ketos-b` with its own
# name. KETOS_RELAY_URLS, KETOS_SYNCTHING_RELAY, and STGUIAPIKEY come from
# docker/relay (see docker/relay/README.md); STGUIAPIKEY is minted per computer
# with `openssl rand -hex 16`, or in PowerShell (Windows has no openssl) with
# `[guid]::NewGuid().ToString('N')`; both give 32 hex characters.

# The participant name always carries the role in parentheses. A value with
# spaces must be quoted; the limit is 64 characters. Computer 2 (ketos-b) uses
# its own name, for example:
# KETOS_PARTICIPANT_NAME="Юрий (Юрист)"
KETOS_PARTICIPANT_NAME="Кирилл (Руководитель)"
KETOS_RELAY_URLS=https://203-0-113-7.sslip.io
KETOS_SYNCTHING_RELAY=relay://203.0.113.7:22067/?id=<RELAY-ID>&token=<STRELAY-TOKEN>
STGUIAPIKEY=replace_with_32_hex_characters

# Model credential for the agent sessions (never baked into the image). Set it
# here OR in the root `.env`, never empty here: this file is read after the
# root `.env`, so an empty value here would replace the key set there.
# OPENCODE_GO_API_KEY=
