{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ketos.test/evidence/stage-10/entity-ledger.schema.json",
  "title": "Ketos Stage 10 Entity Ledger",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "s10_code_sha",
    "owner",
    "retention_policy",
    "started_at",
    "ended_at",
    "command",
    "cwd",
    "exit_code",
    "verdict",
    "canonical_saver",
    "acceptance_run_redacted",
    "entities"
  ],
  "properties": {
    "schema": {"const": "ketos.stage10.entity-ledger.v1"},
    "s10_code_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "owner": {"type": "string", "minLength": 1},
    "retention_policy": {"type": "string", "minLength": 1},
    "started_at": {"type": "string", "format": "date-time"},
    "ended_at": {"type": "string", "format": "date-time"},
    "command": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "cwd": {"type": "string", "minLength": 1},
    "exit_code": {"const": 0},
    "verdict": {"const": "PASS"},
    "canonical_saver": {"type": "string", "pattern": "/mvp/langgraph-checkpoints\\.sqlite3$"},
    "acceptance_run_redacted": {"const": "$KETOS_STAGE10_ACCEPTANCE_RUN_DIR"},
    "entities": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "allOf": [
        {"contains": {"properties": {"kind": {"const": "Project"}}, "required": ["kind"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"kind": {"const": "Board"}}, "required": ["kind"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"kind": {"const": "BoardNote"}}, "required": ["kind"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"kind": {"const": "ChatThread"}}, "required": ["kind"]}, "minContains": 2, "maxContains": 2},
        {"contains": {"properties": {"kind": {"const": "Flow"}}, "required": ["kind"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"kind": {"const": "Job"}}, "required": ["kind"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"kind": {"const": "CommandProposal"}}, "required": ["kind"]}, "minContains": 2, "maxContains": 2},
        {"contains": {"properties": {"kind": {"const": "Placement"}}, "required": ["kind"]}, "minContains": 1, "maxContains": 1}
      ],
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["kind", "id"],
        "properties": {
          "kind": {"type": "string", "minLength": 1},
          "id": {"type": "string", "minLength": 1},
          "revision": {"type": "integer", "minimum": 0}
        }
      }
    }
  }
}
